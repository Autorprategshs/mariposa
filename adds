      "home": ["home_team_data.json.fields.name"],
      "away": ["away_team_data.json.fields.name"],
      "league": ["league"],
      "sport": ["sport"],
      "poster": [
        "contentful_data.fields.horizontal_thumbnails.file.fields.file.url"
      ],
      "dash": [
        "event.channel_data.json.fields.livestreamingUrl.streamingUrlDash",
        "event.channel.livestreamingUrl.streamingUrlDash",
        "data.replayUrlDash",
        "data.streamingUrl"
      ]
    },
    "filters": {
      "filler_sports": ["Programación"],
