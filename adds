      "detail": "content/get-event/{country}/{cid}/other/game",
      "vecima": "streaming/{cid}"
    },
    "playback": {
      "type_content": "{eventType}",
      "index_cam": "0"
    },
    "fields": {
      "content_id": ["contentful_id"],
      "title": [
        "contentful_data.fields.name",
        "contentful_data.fields.title",
        "contentful_data.fields.eventName",
        "contentful_data.fields.matchName"
